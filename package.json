{
  "name": "browser-mcp",
  "private": true,
  "version": "0.2.0",
  "description": "Chrome MV3 extension + MCP server for agent automation of a Connected tab",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r run build",
    "build:server": "pnpm --filter tabmcp build",
    "build:extension": "pnpm --filter @browser-mcp/extension build",
    "dev:server": "pnpm --filter tabmcp dev",
    "typecheck": "pnpm -r run typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.2"
}
